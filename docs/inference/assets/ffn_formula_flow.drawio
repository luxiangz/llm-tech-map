        <mxCell id="ep_router" value="Router&lt;br/&gt;logits = x·W_r → [B, T, N]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="260" height="80" as="geometry" />
