          <mxGeometry x="1360" y="90" width="1150" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ep_panel_title" value="展开：grouped GEMM 内部 = 每个专家的 SwiGLU（与 Sparse MoE 页一致）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1">
