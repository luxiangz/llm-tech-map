          <mxGeometry x="380" y="1130" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ep_sum" value="Weighted Sum（回到源 rank）&lt;br/&gt;y = Σ gᵢ·Eᵢ(x) + E_shared(x)&lt;br/&gt;[B, T, d_model]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="1">
