        <mxCell id="ep_softmax" value="softmax(logits)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="370" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ep_topk" value="TopK → 逻辑路由&lt;br/&gt;每 token 得 (专家号, gᵢ)&lt;br/&gt;在本 rank 完成，无需通信" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ep_shared" value="Shared Expert(s)&lt;br/&gt;每个 rank 完整持有&lt;br/&gt;token 本地计算&lt;br/&gt;&lt;b&gt;不参与 dispatch / combine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ep_dispatch" value="DISPATCH all-to-all&lt;br/&gt;token 按计数/偏移发往专家所在 rank" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="690" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ep_disp_note" value="先行：计数向量交换（每对 rank 一个整数，设备侧完成）&lt;br/&gt;随后：token 本体按偏移写入对端缓冲；&lt;br/&gt;shared expert 旁路不走此通道" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="688" width="480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ep_g1" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fbfcfe;strokeColor=#c7d2e0;strokeWidth=2;" vertex="1" parent="1">
