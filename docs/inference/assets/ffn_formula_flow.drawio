        </mxCell>
        <mxCell id="ep_panel_note" value="DISPATCH 展开：&lt;br/&gt;① 各 rank 在设备上把 topk 结果归约为「每目标 rank 计数」（G 维直方图）；&lt;br/&gt;② 计数点对点写给对端，接收端做前缀和得到分段偏移（全程无 CPU 参与）；&lt;br/&gt;③ token 本体按偏移写入对端接收缓冲，随后进入上图 grouped GEMM。&lt;br/&gt;COMBINE 展开：复用 dispatch 阶段的路由信息（handle），把各专家输出反向送回源 rank，&lt;br/&gt;在源 rank 按 gᵢ 加权求和——一对 all-to-all 即系统文献中的 token all-to-all。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1430" y="440" width="1050" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ep_formula" value="y = Σ_{i∈TopK} gᵢ(x)·Eᵢ(x) + E_shared(x)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1480" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ep_legend" value="红色：被 TopK 选中的 routed expert 及 dispatch/combine 通信通道；灰色：未选中专家；&lt;br/&gt;绿色：本地计算（shared expert、加权求和）；蓝色：数据。专家权重全程不移动。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="1530" width="800" height="66" as="geometry" />
