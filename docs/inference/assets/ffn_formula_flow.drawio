  <diagram id="ep_dispatch_combine_flow" name="EP Dispatch/Combine Flow">
    <mxGraphModel dx="900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="1" />
        <mxCell id="ep_title" parent="1" style="rounded=1;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1;" value="EP 引入后的完整流程：Router → Dispatch → Grouped GEMM → Combine" vertex="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>


        <!-- GPU0 (source rank) -->
        <mxCell id="gpu0_frame" parent="1" style="rounded=1;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="" vertex="1">
          <mxGeometry x="40" y="80" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="gpu0_label" parent="1" style="rounded=1;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" value="GPU0（token 所在 rank）" vertex="1">
          <mxGeometry x="50" y="88" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="tok" parent="1" style="rounded=1;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="batch tokens&lt;br/&gt;x₁ x₂ x₃" vertex="1">
          <mxGeometry x="60" y="130" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="rtr" parent="1" style="rounded=1;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="Router / TopK&lt;br/&gt;softmax + TopK" vertex="1">
          <mxGeometry x="260" y="130" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="idx" parent="1" style="rounded=1;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="topk_ids&lt;br/&gt;+ 路由表" vertex="1">
          <mxGeometry x="420" y="136" width="120" height="34" as="geometry" />
        </mxCell>
        <mxCell id="disp" parent="1" style="rounded=1;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" value="DISPATCH all-to-all&lt;br/&gt;把每个 token 发到其选中专家所在的 rank&lt;br/&gt;（按计数/偏移，见正文 1.4）" vertex="1">
          <mxGeometry x="100" y="220" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="buf" parent="1" style="rounded=1;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="接收缓冲&lt;br/&gt;按源分段" vertex="1">
          <mxGeometry x="400" y="226" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note_shared" parent="1" style="rounded=1;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" value="shared expert 在本 rank 直接计算，不走 dispatch" vertex="1">
          <mxGeometry x="60" y="300" width="480" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="tok" target="rtr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="rtr" target="idx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="idx" target="disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="disp" target="buf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- GPU1 (expert rank) -->
        <mxCell id="gpu1_frame" parent="1" style="rounded=1;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="" vertex="1">
          <mxGeometry x="620" y="80" width="540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="gpu1_label" parent="1" style="rounded=1;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" value="GPU1（专家 E0/E1 所在 rank）" vertex="1">
          <mxGeometry x="630" y="88" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="exp" parent="1" style="rounded=1;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="本 rank 专家&lt;br/&gt;E0, E1（各一个小 FFN）" vertex="1">
          <mxGeometry x="640" y="130" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gemm" parent="1" style="rounded=1;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" value="grouped GEMM&lt;br/&gt;gate/up → SiLU ⊙ up → down&lt;br/&gt;（按专家分组，权重本地不动）" vertex="1">
          <mxGeometry x="640" y="216" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" parent="1" style="rounded=1;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="专家输出&lt;br/&gt;y₀ = g₀·E0(x₀) …" vertex="1">
          <mxGeometry x="940" y="222" width="180" height="48" as="geometry" />
        </mxCell>

        <mxCell id="b1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="exp" target="gemm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="gemm" target="out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disp_out" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="token 到位" edge="1" source="buf" target="gemm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- Combine -->
        <mxCell id="comb" parent="1" style="rounded=1;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" value="COMBINE all-to-all&lt;br/&gt;把专家输出送回 token 原所在 rank&lt;br/&gt;并按 gᵢ 加权求和" vertex="1">
          <mxGeometry x="700" y="420" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="final" parent="1" style="rounded=1;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="残差相加 / 下层输入&lt;br/&gt;y = Σ gᵢ·Eᵢ(x) + shared" vertex="1">
          <mxGeometry x="380" y="426" width="220" height="44" as="geometry" />
        </mxCell>

        <mxCell id="c1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="out" target="comb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" value="" edge="1" source="comb" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- legend -->
        <mxCell id="lg1" parent="1" style="rounded=1;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="一对 all-to-all（dispatch + combine）= 论文/系统里说的「token all-to-all」；权重不移动，只有 token 与其输出在走。" vertex="1">
          <mxGeometry x="40" y="520" width="1120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=1;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="计数交换（每个源 rank → 每个目的 rank 发多少 token）先行于数据搬运：现代实现（DeepEP 等）在设备侧交换计数向量，避免 host 上全量元数据往返；ULTRAEP 类系统再按副本配额改写 token 的目的地（逻辑路由 → 物理路由）。" vertex="1">
          <mxGeometry x="40" y="556" width="1120" height="44" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
