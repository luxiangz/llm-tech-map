        </mxCell>
        <mxCell id="ep_g0_label" value="GPU0 · token 所在 rank（Attention 输出后）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="88" width="520" height="28" as="geometry" />
