        <mxCell id="s1_ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1_d7" target="s1_d8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1_f1" value="3 段 → 1（通算融合）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=2;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="s1_g1" target="s1_m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1_f2" value="3 段 → 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=2;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="s1_g2" target="s1_m6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1_f3" value="5 段 → 1：FFN 也融进同一 kernel（整链大融合）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=2;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="s1_g3" target="s1_c2"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ascend_moe_allgather" name="ALLGATHER DP 复制">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="950" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s2_title" value="ALLGATHER（DP 复制专家）· 2 卡示例 —— 每卡存全部专家 E0~E3，all_gather 收齐全量 token 本地算完，reduce_scatter 各取一片" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1280" height="34" as="geometry" /></mxCell>
        <mxCell id="s2_in0" value="NPU 0 本卡输入&lt;br&gt;t0 t1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="70" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="s2_in1" value="NPU 1 本卡输入&lt;br&gt;t2 t3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="s2_q" value="quant（量化降流量）→ all_gather(DP)：每卡收集 DP 组内全部 token，得到全量 batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="1120" height="56" as="geometry" /></mxCell>
        <mxCell id="s2_card0" value="NPU 0 —— 全部专家的完整副本" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="520" height="350" as="geometry" /></mxCell>
        <mxCell id="s2_t0" value="收到的全量 token：t0 t1 t2 t3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="296" width="480" height="36" as="geometry" /></mxCell>
        <mxCell id="s2_e00" value="E0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e01" value="E1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="264" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e02" value="E2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="388" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e03" value="E3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_c0" value="init_routing → gmm(gate_up) → SiLU → gmm(down) → unpermute + weighted sum&lt;br&gt;全部 token（t0~t3）× 全部专家（E0~E3）本地计算&lt;br&gt;—— 与 NPU 1 做的是完全相同的计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="434" width="484" height="140" as="geometry" /></mxCell>
        <mxCell id="s2_card1" value="NPU 1 —— 全部专家的完整副本" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="520" height="350" as="geometry" /></mxCell>
        <mxCell id="s2_t1" value="收到的全量 token：t0 t1 t2 t3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="296" width="480" height="36" as="geometry" /></mxCell>
        <mxCell id="s2_e10" value="E0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e11" value="E1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="864" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e12" value="E2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="988" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_e13" value="E3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1112" y="350" width="112" height="60" as="geometry" /></mxCell>
        <mxCell id="s2_c1" value="init_routing → gmm(gate_up) → SiLU → gmm(down) → unpermute + weighted sum&lt;br&gt;全部 token（t0~t3）× 全部专家（E0~E3）本地计算&lt;br&gt;—— 与 NPU 0 做的是完全相同的计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="434" width="484" height="140" as="geometry" /></mxCell>
        <mxCell id="s2_rs" value="reduce_scatter(DP)：把各卡的完整输出按卡切分 —— NPU 0 取回 t0、t1 的输出，NPU 1 取回 t2、t3 的输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="650" width="1120" height="56" as="geometry" /></mxCell>
        <mxCell id="s2_o0" value="NPU 0 输出：out(t0) out(t1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="740" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="s2_o1" value="NPU 1 输出：out(t2) out(t3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="740" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="s2_note" value="Trade-off：通信侧 —— 把复杂、动态不等长的 all-to-all 换成规则的 all_gather + reduce_scatter，可先量化压缩流量，且 token 无跨卡分发等待；计算/显存侧 —— 每卡显存 = 全量专家权重（512 专家规模不现实），两卡做完全相同的计算 ⇒ N 倍计算冗余（N = DP 卡数）。适用：专家数少（≤16）· 显存充裕 · 快速上线或作对比基线。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="820" width="1120" height="96" as="geometry" /></mxCell>
        <mxCell id="s2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="s2_in0" target="s2_q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="s2_in1" target="s2_q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2_q" target="s2_card0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2_q" target="s2_card1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="s2_card0" target="s2_rs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="s2_card1" target="s2_rs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2_rs" target="s2_o0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2_rs" target="s2_o1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ascend_moe_zercmoe" name="ZercMoe 单 kernel 流水">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="860" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s3_title" value="FUSED_MC2 的案例实现（ZercMoe）—— 单次 MIX kernel 发射完成全流程：卡间 aclshmem P2P 直连 + 卡内 AIC/AIV 专家组粒度流水" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="34" as="geometry" /></mxCell>
        <mxCell id="s3_kernel" value="单次 kernel 发射（mega_moe 内部，AIC : AIV = 1 : 2）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;dashed=1;fillColor=#fcfdfe;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="1180" height="120" as="geometry" /></mxCell>
        <mxCell id="s3_p1" value="sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f4f8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="116" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p2" value="dispatch（P2P 直写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="366" y="116" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p3" value="GMM1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="542" y="116" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p4" value="SiLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="698" y="116" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p5" value="GMM2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="854" y="116" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p6" value="combine（累加回源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="116" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_p7" value="unpermute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1186" y="116" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="s3_ep1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p1" target="s3_p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_ep2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p2" target="s3_p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_ep3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p3" target="s3_p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_ep4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p4" target="s3_p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_ep5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p5" target="s3_p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_ep6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_p6" target="s3_p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_av_lab" value="AIV（向量核）&lt;br&gt;token 拷贝 / 同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_av0" value="AIV 拷贝专家组 0&lt;br&gt;（去重后 P2P 直写对卡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_av1" value="AIV 拷贝专家组 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="270" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_av2" value="AIV 拷贝专家组 2 …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_axis" value="时间 →" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#666666;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1400" y="286" width="110" height="32" as="geometry" /></mxCell>
        <mxCell id="s3_ac_lab" value="AIC（Cube 核）&lt;br&gt;专家 GEMM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_ac0" value="GMM1（专家组 0）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="450" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_ac0b" value="GMM2（组 0）&lt;br&gt;epilogue 提前启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="450" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_ac1" value="GMM1（专家组 1） …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="450" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="s3_s1" value="CrossCoreSetFlag（SYNCFLAGC2V，IsSyncTask 2 的幂次分批）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="s3_av0" target="s3_ac0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_s2" value="flag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;fontSize=12;fontColor=#b85450;" edge="1" parent="1" source="s3_av1" target="s3_ac1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_pnote" value="流水含义：AIV 拷贝专家组 1 的同时，AIC 已在算专家组 0 的 GMM —— 通信与计算在单 kernel 内重叠；GMM2 的 epilogue 按 gmDequantSum 分批提前启动，不等全部专家算完。" style="text;html=1;fontSize=13;fontColor=#116329;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="552" width="1120" height="40" as="geometry" /></mxCell>
        <mxCell id="s3_k1" value="增强 ① 零冗余去重（Zero-Redundant）&lt;br&gt;同一 token 路由到本 rank 多个专家时，基础 MegaMoe 会重复发送多次；ZercMoe 用 distTokenFirstPos / distTokenLastPos 去重，每（token, dstRank）只传一次，卡内分发靠本地内存拷贝。combine 反向：卡内先把多专家结果按路由权重加权累加，再写一次回源卡。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="460" height="170" as="geometry" /></mxCell>
        <mxCell id="s3_k2" value="增强 ② aclshmem 对称堆 + kernel 内 P2P 直连（绕过 HCCL）&lt;br&gt;不用 HCCL all_to_all 集合通信：对称堆上以 shmem(offset, rank) + MTE 搬运直接 peer 读写。收益：不经 HCCL 调度器 · 无 ccl_buffer 公式约束 · 大 batch（m≥512）不炸 · 与去重后的不规则 P2P 流量天然适配。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="620" width="460" height="170" as="geometry" /></mxCell>
        <mxCell id="s3_k3" value="增强 ③ AIC/AIV 专家组粒度流水（见上方时间轴）&lt;br&gt;单次发射完成 sort→dispatch→GMM1→SiLU→GMM2→combine→unpermute；AIV 每完成一组 token 拷贝即置 flag 通知 AIC 开算该组 GMM1；epilogue 按 gmDequantSum 分批提前启动。跨卡传输按「卡」去重后，每（token, dstRank）恰好一次。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="460" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
