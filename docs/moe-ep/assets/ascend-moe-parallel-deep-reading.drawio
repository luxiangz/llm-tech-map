<mxfile host="app.diagrams.net" pages="3">
  <diagram id="ascend_moe_pipelines" name="四方案流水线对照">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1060" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1_title" value="四方案流水线对照 —— 融合递进：ALLTOALL → MC2 → FUSED_MC2（TP 专家并行路线）；ALLGATHER（DP 复制，独立路线）" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2120" height="34" as="geometry" /></mxCell>
        <mxCell id="s1_l1" value="ALLTOALL&lt;br&gt;TP · 标准 EP 基线&lt;br&gt;10 算子 · 无融合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="170" height="96" as="geometry" /></mxCell>
        <mxCell id="s1_a1" value="pad + TP split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f4f8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a2" value="permute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="416" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a3" value="all_to_all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="592" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a4" value="permute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="768" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a5" value="gmm(gate_up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="944" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a6" value="SiLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a7" value="gmm(down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1296" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a8" value="unpermute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1472" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a9" value="all_to_all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1648" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a10" value="unpermute + weighted sum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1824" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_a11" value="all_gather(TP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2000" y="130" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_g1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="406" y="122" width="522" height="72" as="geometry" /></mxCell>
        <mxCell id="s1_g2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1462" y="122" width="522" height="72" as="geometry" /></mxCell>
        <mxCell id="s1_n1" value="痛点：两次 all_to_all 跨卡通信（8 卡场景约占推理时间 30%）· 每个算子的输出都要写 HBM 再由下一算子读入 · 通信与 FFN 计算严格串行，通信等待无法被计算隐藏" style="text;html=1;fontSize=13;fontColor=#82071e;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="240" y="202" width="1910" height="40" as="geometry" /></mxCell>
        <mxCell id="s1_l2" value="MC2&lt;br&gt;TP · 通算融合&lt;br&gt;7 算子 · 当前主力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="170" height="96" as="geometry" /></mxCell>
        <mxCell id="s1_m1" value="pad + TP split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f4f8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="334" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_m2" value="distribute_dispatch（通算融合算子）&lt;br&gt;= permute + all_to_all + permute&lt;br&gt;通信与重排在片上 buffer 流水完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="416" y="326" width="502" height="72" as="geometry" /></mxCell>
        <mxCell id="s1_m3" value="gmm(gate_up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="944" y="334" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_m4" value="SiLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="334" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_m5" value="gmm(down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1296" y="334" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_m6" value="distribute_combine（通算融合算子）&lt;br&gt;= unpermute + all_to_all + unpermute&lt;br&gt;反向重排 + 聚合 + 恢复原始顺序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1472" y="326" width="502" height="72" as="geometry" /></mxCell>
        <mxCell id="s1_m7" value="all_gather(TP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2000" y="334" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_g3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="406" y="318" width="1578" height="88" as="geometry" /></mxCell>
        <mxCell id="s1_n2" value="收益（vs ALLTOALL）：算子 10 → 7 · 被融合三段的中间张量不再落 HBM（融合算子内部片上流转）· 通信与重排流水重叠、部分隐藏通信延迟 · 分发/聚合侧各 3 次 kernel 启动合并为 1 次" style="text;html=1;fontSize=13;fontColor=#116329;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="240" y="408" width="1910" height="40" as="geometry" /></mxCell>
        <mxCell id="s1_l3" value="FUSED_MC2&lt;br&gt;TP · 整链 MegaKernel&lt;br&gt;3 算子（核心 1 个）· 长期目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="s1_c1" value="pad + TP split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f4f8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="547" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_c2" value="mega_moe（dispatch_ffn_combine 整链 MegaKernel）&lt;br&gt;sort → dispatch → GMM1 → SiLU → GMM2 → combine → unpermute 全在单 kernel 内&lt;br&gt;分发通信 ‖ FFN 计算 ‖ 聚合通信 深度流水 · 中间结果驻留片上 buffer / 寄存器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="416" y="520" width="1558" height="110" as="geometry" /></mxCell>
        <mxCell id="s1_c3" value="all_gather(TP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2000" y="547" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_n3" value="收益（vs MC2）：7 → 3 算子、kernel 启动开销最低 · 中间张量 HBM 往返最少 · 通信计算重叠最大；代价：单 kernel 内要处理动态路由 token 不均、grouped GEMM tiling 与负载均衡、通信 buffer 与计算并发调度、动态 shape —— 工程复杂度最高，需多轮迭代" style="text;html=1;fontSize=13;fontColor=#116329;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="240" y="636" width="1910" height="40" as="geometry" /></mxCell>
        <mxCell id="s1_l4" value="ALLGATHER&lt;br&gt;DP · 专家全复制&lt;br&gt;7 算子 · 独立路线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#9aa4b2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="170" height="96" as="geometry" /></mxCell>
        <mxCell id="s1_d1" value="quant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f4f8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d2" value="all_gather(DP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="416" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d3" value="init_routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="592" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d4" value="gmm(gate_up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="768" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d5" value="SiLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="944" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d6" value="gmm(down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d7" value="unpermute + weighted sum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1296" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_d8" value="reduce_scatter(DP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1472" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="s1_n4" value="换问题而非优化问题：每卡全量专家 ⇒ 无 all-to-all、无跨卡 token 重排，通信换成规则的 all_gather + reduce_scatter（且先 quant 降流量）、无跨卡分发等待；代价：专家显存 ×N、每卡算全 batch 计算冗余 ×N —— 512 专家规模不现实，定位为小专家数 / 对比基线场景备选" style="text;html=1;fontSize=13;fontColor=#7d4e00;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="240" y="832" width="1910" height="40" as="geometry" /></mxCell>
        <mxCell id="s1_lg" value="图例：蓝 = 专家 FFN 计算（gmm / SiLU）· 绿 = 通信原语与融合通信算子 · 黄 = 数据重排（permute / unpermute）· 灰 = 预处理 · 橙 = 路由计算 · 红虚线框 = 被融合的算子段 · 红虚线箭头 = 融合方向&lt;br&gt;口径说明：算子计数（10 / 7 / 7 / 3）沿用案例材料 —— pad、quant 等预处理段与复合算子（unpermute + weighted sum）各计 1；三个 TP 方案收尾的 all_gather(TP) 相同&lt;br&gt;配套手段（本图未画）：alltoallv_gmm / gmm_alltoallv 通信—计算融合、decode 阶段注意力算子链融合、权重预取" style="text;html=1;fontSize=12;fontColor=#666666;align=left;spacing=10;strokeColor=#d8dee4;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="2120" height="100" as="geometry" /></mxCell>
