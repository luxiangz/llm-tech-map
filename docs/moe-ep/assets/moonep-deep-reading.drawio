<mxfile host="app.diagrams.net" pages="2">
  <diagram id="moonep_pipeline" name="MoonEP 端到端数据流">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1120" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="MoonEP 前向：在线规划 → 预取 → 融合 permute 的 dispatch → 静态形状 group GEMM → 融合 unpermute 的 combine（每 rank 恒定 S×K token）" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="16" width="1360" height="34" as="geometry" /></mxCell>
        <mxCell id="ph1" value="① 每步在线规划（planning.py，单 cooperative grid）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="500" height="26" as="geometry" /></mxCell>
        <mxCell id="ph2" value="② 通信与计算（每层静态 shape，无 host 同步）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="ph3" value="③ 反向（plan 复用 + 梯度归约）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="360" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="本 rank 真实路由&lt;br&gt;topk[N] + tokens_per_expert[E]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="a2" value="A0 汇聚：multimem 多播 tpe/topk&lt;br&gt;rank0 算专家前缀和 + 组 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="a3" value="A1 组间贪心互填（CAP = S×K）&lt;br&gt;超载组 → 最空组，受方一次补满&lt;br&gt;⇒ 每 rank 恰收 S×K 实 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="a4" value="A2 专家级过户 alloc[e,d]&lt;br&gt;A3 选 B 个预取专家 + 铺 cu_seqlens&lt;br&gt;rank0 一次广播整张规划表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="a5" value="B/C 每 rank 本地排序 + 二分落位&lt;br&gt;dst = rank·NvS + 段内偏移（同 dest 重复项负编码 dedup）&lt;br&gt;设备端 barrier 发布，全程无 host 往返" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="670" y="230" width="650" height="90" as="geometry" /></mxCell>
        <mxCell id="a6" value="规划产物（MoonEPCommPlan，前后向复用）&lt;br&gt;dst[N] · cu_seqlens[E+B] · experts_to_copy[R,B] · zero_fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="b1" value="prefetch_weight（与 dispatch 并行）&lt;br&gt;2D TMA 把 B 个远端专家权重&lt;br&gt;拷入本 rank 预取槽 [E,E+B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="290" height="90" as="geometry" /></mxCell>
        <mxCell id="b2" value="dispatch：cp.async.bulk 直写&lt;br&gt;远端 expert-grouped 槽位&lt;br&gt;（permute 融进通信；权重 int32 scatter；&lt;br&gt;zero warp 清 padding；builder 物化 dedup）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="390" y="450" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="b3" value="dispatch_epilogue（本地）&lt;br&gt;primary 行扇出到全部副本槽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="b4" value="group GEMM（框架侧）&lt;br&gt;按 cu_seqlens 读统一权重张量 [E+B,H,H']&lt;br&gt;zero_copy：直接在 NVL 视图上原地读写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1050" y="450" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="b5" value="combine_prologue（本地预规约）&lt;br&gt;重复行 fp32 累加回 primary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="620" width="330" height="80" as="geometry" /></mxCell>
        <mxCell id="b6" value="combine：只拉 primary 行&lt;br&gt;G2S→S2G 累加回 token-major [S,H]&lt;br&gt;（unpermute 融进通信；权重原样 gather 回 [S,K]）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="615" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="b7" value="输出 hidden_sh[S,H] + route_weights_sk[S,K]&lt;br&gt;每 rank 计算量恒定 S×K token、形状完全静态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="c1" value="combine bwd：复用保存的 plan 重新 dispatch&lt;br&gt;（跳过规划与预取）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="c2" value="GEMM bwd：预取槽梯度写入独立 reduce buffer&lt;br&gt;[R,B,H,H'] fp32（不污染框架自身梯度归约）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="880" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="c3" value="grad_reduce：每个 home rank 经 NVLink&lt;br&gt;远端读回自己专家的槽梯度、fp32 累加&lt;br&gt;cross_rank_barrier 后只本地清槽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="920" y="870" width="360" height="100" as="geometry" /></mxCell>
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eplan1" value="plan 驱动 prefetch / dispatch / GEMM 寻址" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a6" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="400" /><mxPoint x="555" y="400" /></Array></mxGeometry></mxCell>
        <mxCell id="eplan2" value="experts_to_copy → 预取表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="a6" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="430" /><mxPoint x="205" y="430" /></Array></mxGeometry></mxCell>
        <mxCell id="lg" value="图例：蓝 = 数据/框架侧；绿 = MoonEP 通信内核；红 = 规划内核（核心）；橙 = 反向路径；黄 = 规划产物&lt;br&gt;工程底座：CUTLASS Python DSL（CuTe）JIT + inline PTX；VMM 对称内存全 RW + NVSwitch multicast 广播；自复位 grid/cross-rank barrier + PDL ⇒ 无 host 同步" style="text;html=1;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="1000" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="moonep_balance" name="完美均衡的构造">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="960" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="「完美均衡」的构造：CAP = S×K 的贪心互填 —— 性质由构造保证，与路由倾斜无关" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="16" width="1260" height="34" as="geometry" /></mxCell>
        <mxCell id="lA" value="路由自然倾斜（每 rank 输入 S 个 token × K 路由 ⇒ 各 rank 产出恰 S×K 条目）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="700" height="26" as="geometry" /></mxCell>
        <mxCell id="bar1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="110" y="230" width="90" height="320" as="geometry" /></mxCell>
        <mxCell id="bar2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="430" width="90" height="120" as="geometry" /></mxCell>
        <mxCell id="bar3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="500" width="90" height="50" as="geometry" /></mxCell>
        <mxCell id="capL" value="CAP = S×K" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#b85450;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="348" width="120" height="26" as="geometry" /></mxCell>
        <mxCell id="capline" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="bar1" target="capL"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="360" /></Array></mxGeometry></mxCell>
        <mxCell id="lb1" value="rank 0：3.2×CAP&lt;br&gt;（热专家扎堆）" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="560" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="lb2" value="rank 1：0.75×CAP" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="235" y="560" width="140" height="26" as="geometry" /></mxCell>
        <mxCell id="lb3" value="rank 2：0.4×CAP" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="385" y="560" width="140" height="26" as="geometry" /></mxCell>
        <mxCell id="dB" value="DeepEP 式分配：步时由最热 rank 决定&lt;br&gt;≈ 3.2×CAP 的通信与等待；失衡越大越糟&lt;br&gt;（MoonEP 规划前同样如此）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="420" height="90" as="geometry" /></mxCell>
        <mxCell id="rA" value="MoonEP 规划后：贪心互填到 CAP" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="500" height="26" as="geometry" /></mxCell>
        <mxCell id="nbar1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5B8748;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="90" height="250" as="geometry" /></mxCell>
        <mxCell id="nbar2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5B8748;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="90" height="250" as="geometry" /></mxCell>
        <mxCell id="nbar3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5B8748;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="90" height="250" as="geometry" /></mxCell>
        <mxCell id="ncapline" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="300" /><mxPoint x="1240" y="300" /></mxGeometry></mxCell>
        <mxCell id="ncapL" value="每 rank 恰好 S×K" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#5B8748;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="950" y="272" width="180" height="26" as="geometry" /></mxCell>
        <mxCell id="nlb1" value="rank 0：本地保留 S×K&lt;br&gt;（超出的 2.2×CAP 迁出）" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="775" y="560" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="nlb2" value="rank 1：本地 + 迁入补满" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="925" y="560" width="140" height="26" as="geometry" /></mxCell>
        <mxCell id="nlb3" value="rank 2：本地 + 迁入补满" style="text;html=1;fontSize=12;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1075" y="560" width="140" height="26" as="geometry" /></mxCell>
        <mxCell id="m1" value="A1 贪心互填（伪码）&lt;br&gt;bal[h] = group_tokens[h] − CAP     （Σbal = 0）&lt;br&gt;while (h = argmax bal) &gt; 0:&lt;br&gt;    u = argmin bal; z[h,u] = −bal[u]&lt;br&gt;    bal[h] += bal[u]; bal[u] = 0     （受方一次补满）&lt;br&gt;A2：把配额落到专家 → alloc[e,d]；A3：选 B 个迁入专家预取权重" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f2f4f8;strokeColor=#666666;fontFamily=Cascadia Code;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="640" height="150" as="geometry" /></mxCell>
        <mxCell id="mv" value="迁移 = 通信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b85450;endArrow=block;exitX=1;exitY=0.35;entryX=0;entryY=0.35;dashed=1;" edge="1" parent="1" source="bar1" target="nbar1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="342" /></Array></mxGeometry></mxCell>
        <mxCell id="why" value="为什么「恰好 S×K」由构造保证：① 每个源 rank 恰好输出 S×K 条目；② 每列（目标）配额 ≤ CAP；③ 贪心循环终态把全部空余填满 ⇒ 无需断言、测试只验守恒/容量不变量&lt;br&gt;代价：迁入专家在本 rank 无权重 ⇒ 动态冗余（预取槽复制权重 / 对称内存直读兜底），梯度经 grad_reduce 归约回 home rank" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="1340" height="90" as="geometry" /></mxCell>
        <mxCell id="lg2" value="示意数字（3 rank、CAP=1）；实际：8×H20、E=384、H=7168、K=8、S=8192/rank 实测 —— 规划后 comm 时间随 maxvio（0.2→20）几乎不变，DeepEP v2 持续恶化" style="text;html=1;fontSize=12;fontColor=#666666;align=center;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="660" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
