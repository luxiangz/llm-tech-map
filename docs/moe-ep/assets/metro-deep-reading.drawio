<mxfile host="app.diagrams.net" pages="2">
  <diagram id="metro_pipeline" name="METRO 端到端流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1040" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="METRO（decode 路径）：均衡「激活专家数」而不是 token 数 —— 每个 token 选定唯一副本，最小化每 GPU 激活副本数" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="16" width="1300" height="34" as="geometry" /></mxCell>
        <mxCell id="ph1" value="① 通信改造：all-gather 替代 all-to-all（top-k 之前）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="460" height="26" as="geometry" /></mxCell>
        <mxCell id="ph2" value="② 全局信息 → 逐专家决策" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="360" height="26" as="geometry" /></mxCell>
        <mxCell id="ph3" value="③ 按 METRO 选择的结果 dispatch" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="360" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="decode 隐状态（每 GPU 本地 batch ≤ 32）&lt;br&gt;传统：top-k 后 all-to-all dispatch，他卡 token 不可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="330" height="76" as="geometry" /></mxCell>
        <mxCell id="a2" value="all-gather 全量隐状态&lt;br&gt;（NVLink 上 2MB ≈ 3 µs，&lt;br&gt;远低于 NCCL 集合通信固定开销）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="300" height="76" as="geometry" /></mxCell>
        <mxCell id="a3" value="每 GPU 对全量 token 跑 top-k&lt;br&gt;（冗余计算 &lt; 1%）&lt;br&gt;→ 得到全局负载 T[1..N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="300" height="76" as="geometry" /></mxCell>
        <mxCell id="a4" value="Algorithm 1（单 SM CUDA kernel，集成于 vLLM CUDA Graph，零额外 launch）&lt;br&gt;每个有 token 的专家 i 并行：&lt;br&gt;按全序锁住候选 GPU 集 {g : A[i,g]=1}&lt;br&gt;选 g* = argmin L[g]（激活数最少的卡）→ y[i,g*]=1, L[g*]+=1&lt;br&gt;复杂度 O(|A|)，计数器/锁在 shared memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="640" height="150" as="geometry" /></mxCell>
        <mxCell id="a5" value="每个 token 的目标专家&lt;br&gt;路由到唯一选中的副本槽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="a6" value="dispatch（all-to-all）&lt;br&gt;每 GPU 只激活必要副本 → 权重加载量最小" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="740" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="n1" value="形式化 min-exp-routing：min λ s.t. 每 GPU 激活专家数 ≤ λ、Σ_g x[i,g]=T[i]（不丢 token）、遵守放置矩阵 A、x ≤ T·y&lt;br&gt;Lemma 1：最优解必是「每专家全部 token 走单一副本」→ 问题归约为选副本&lt;br&gt;最优算法（二分 λ + 二部图匹配）太贵：CPU Dinic 116–129 µs（占单层 FFN 31–43%）；GPU push-relabel 290 µs（86–104%）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="400" height="190" as="geometry" /></mxCell>
        <mxCell id="n2" value="贪心质量：激活数最多比最优高 10.9%，比 EPLB 路由低最多 42.3%" style="text;html=1;fontSize=13;align=center;strokeColor=none;fillColor=#f2f4f8;rounded=1;" vertex="1" parent="1"><mxGeometry x="500" y="570" width="640" height="40" as="geometry" /></mxCell>
        <mxCell id="n3" value="prefill 路径不动：仍用 EPLB 均分路由（compute-bound，token 均衡是对的）；METRO 只换 decode" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="740" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="700" /><mxPoint x="1335" y="690" /><mxPoint x="1060" y="690" /></Array></mxGeometry></mxCell>
        <mxCell id="lg" value="图例：蓝 = 数据；绿 = 计算/通信；红 = METRO 核心；黄 = 形式化与边界说明&lt;br&gt;不改 top-k、不改放置/复制（复用 EPLB）、不改权重、无需重训——纯 decode 路由层优化" style="text;html=1;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="820" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="metro_example" name="玩具例子：EPLB vs METRO"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="玩具例子：2 GPU × 4 槽位，专家 E2 有 2 副本（GPU0、GPU1 各一份），6 个 token 要去 E2" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="16" width="1200" height="32" as="geometry" /></mxCell>
        <mxCell id="gA" value="EPLB 路由：token 均分到所有副本（token 均衡目标）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="620" height="330" as="geometry" /></mxCell>
        <mxCell id="gA0" value="GPU 0" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="130" width="260" height="132" as="geometry" /></mxCell>
        <mxCell id="gA0e1" value="E1（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="126" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gA0e2" value="E2 副本&lt;br&gt;收 3 token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="241" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gA0e3" value="E3（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="126" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gA0e4" value="E4（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="241" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gA1" value="GPU 1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="260" height="132" as="geometry" /></mxCell>
        <mxCell id="gA1e1" value="E5（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="426" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gA1e2" value="E2 副本&lt;br&gt;收 3 token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="541" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gA1e3" value="E7（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="426" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gA1e4" value="E8（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="541" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gAres" value="结果：token 完美均衡（每卡 3）——但&lt;b&gt;两张卡都被迫激活 E2 副本&lt;br&gt;= 每卡多加载一份完整专家权重&lt;/b&gt;&lt;br&gt;复制率越高膨胀越重：1.5× 复制下 EPLB 激活数 +30% → decode 延迟 +14% → 吞吐 -10%" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="290" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="gB" value="METRO 路由：全部 token 走单一副本（激活专家数目标）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="80" width="620" height="330" as="geometry" /></mxCell>
        <mxCell id="gB0" value="GPU 0" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="260" height="132" as="geometry" /></mxCell>
        <mxCell id="gB0e1" value="E1（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gB0e2" value="E2 副本&lt;br&gt;收 6 token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="951" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gB0e3" value="E3（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gB0e4" value="E4（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="951" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gB1" value="GPU 1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="260" height="132" as="geometry" /></mxCell>
        <mxCell id="gB1e1" value="E5（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1136" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gB1e2" value="E2 副本&lt;b&gt;不激活&lt;/b&gt;&lt;br&gt;权重不加载" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#999999;fontColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1251" y="170" width="105" height="42" as="geometry" /></mxCell>
        <mxCell id="gB1e3" value="E7（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1136" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gB1e4" value="E8（闲）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1251" y="220" width="105" height="36" as="geometry" /></mxCell>
        <mxCell id="gBres" value="结果：token 数不均衡（6 vs 0）——但&lt;b&gt;只有一张卡激活 E2&lt;/b&gt;&lt;br&gt;memory-bound 下运行时 ∝ 激活专家数：GPU1 完全不加载该权重&lt;br&gt;真实系统：decode 延迟 -1.9%～-21.8%，吞吐 +0.7%～+21%；固定 SLO 下吞吐 1.98×–4.11× EPLB" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="why" value="为什么 token 不均衡反而更快：decode 是 memory-bound——每步耗时由「加载多少份专家权重」决定，与多几个 token 几乎无关（激活值流量 &lt; 专家权重的 0.6%，即使 batch 11K）&lt;br&gt;EPLB 的 token 均衡假设在 compute-bound 下成立；在 memory-bound 的 decode 下恰好把「激活副本数」翻倍" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="1330" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel></diagram>
</mxfile>
