<mxfile host="app.diagrams.net" pages="2">
  <diagram id="lplb_pipeline" name="LPLB 端到端流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1080" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="LPLB 端到端：每个 micro-batch 的「计数 → LP 求解 → 加权分流」（GPU 上 ~100 µs 级），外环低频换冗余布局" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="140" y="16" width="1260" height="34" as="geometry" /></mxCell>
        <mxCell id="phA" value="内环 · 每个 micro-batch、每层（dispatch 之前）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="26" as="geometry" /></mxCell>
        <mxCell id="phB" value="外环 · 低频（负载分布漂移时）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="Router TopK indices&lt;br&gt;[T, K]（本 batch 每个 token 选中的逻辑专家）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="a2" value="kernel_count_idx（多 SM）&lt;br&gt;atomicAdd 直方图 + 每 SM 前缀和&lt;br&gt;→ workload[n_logical] · by_sm[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="270" height="66" as="geometry" /></mxCell>
        <mxCell id="a3" value="组内聚合&lt;br&gt;view 成 [n_group, 8, n_local_logical]&lt;br&gt;all_reduce / DeepEP 通信子同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="260" height="66" as="geometry" /></mxCell>
        <mxCell id="a4" value="minilp 求解（每 8 卡组一个实例）&lt;br&gt;单 SM 仿射尺度内点法 · 5 次迭代&lt;br&gt;cuBLASDx 矩阵乘 + cusolverdx 块高斯消元&lt;br&gt;→ o_weight[8, D] 分流比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="106" width="320" height="94" as="geometry" /></mxCell>
        <mxCell id="a5" value="kernel_map_idx：逐 token 逻辑 → 物理槽&lt;br&gt;复制专家按 (count×499+41) % total 伪随机数&lt;br&gt;对照期望配额 o_weight × total 二分到原槽/副本槽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="320" height="86" as="geometry" /></mxCell>
        <mxCell id="a6" value="redirected_indices&lt;br&gt;→ DeepEP dispatch（按物理专家收发）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="262" width="260" height="62" as="geometry" /></mxCell>
        <mxCell id="a7" value="grouped GEMM&lt;br&gt;各 rank 按分流比承担负载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="262" width="240" height="62" as="geometry" /></mxCell>
        <mxCell id="fa" value="可行性检查 avail_flag：d_max &lt; 0.1 · 人工变量 ≈ 0 · 残差 &lt; 0.05&lt;br&gt;不可行 → 回退 0.5/0.5 均分，avail_counter 记录可用组数" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="230" height="86" as="geometry" /></mxCell>
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eaf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="a4" target="fa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b1" value="① EPLB rebalance_experts（nored，无冗余版本）&lt;br&gt;按历史统计把逻辑专家均衡排到各 rank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="400" height="76" as="geometry" /></mxCell>
        <mxCell id="b2" value="② 每 rank 按历史负载降序排序本地专家&lt;br&gt;取 top (combined_redundant × D) 个作为待复制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="850" width="400" height="76" as="geometry" /></mxCell>
        <mxCell id="b3" value="③ 按 r2o 拓扑放副本（每条冗余边恰连 2 个 rank）&lt;br&gt;phy2log / log2phy / logcnt（max=2：每专家 ≤ 原件+1 副本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="980" y="850" width="440" height="76" as="geometry" /></mxCell>
        <mxCell id="eb12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eloop" value="新冗余布局供内环使用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="b3" target="a3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="640" /><mxPoint x="830" y="640" /></Array></mxGeometry></mxCell>
        <mxCell id="lg" value="图例：蓝 = 数据；绿 = 计算/通信；红 = LP 核心；橙 = 外环布局计算（复用 EPLB）；黄 = 容错机制&lt;br&gt;内环每 batch 每层跑一次（节点内 ~100 µs，跨组需 NVSHMEM 同步更久）；外环频率低得多（负载分布漂移时）" style="text;html=1;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="900" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lplb_lp" name="LP 模型与 CUBE 拓扑"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="LP 模型（每 8 卡组）：最小化组内最大负载，自由度 = 每条冗余边的分流比" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="16" width="1200" height="32" as="geometry" /></mxCell>
        <mxCell id="f1" value="$$\min\ \ t \quad \text{s.t.}\quad \underbrace{\mathrm{load}_g(t) = b_g + \sum_d w_{g,d}\, o_{g,d} + \sum_{(k,d):\, r2o[k,d]=g} w_{k,d}\, r_{k,d} \le t}_{\text{8 条负载行（} b_g = \text{固定负载}）}\ ,\quad \underbrace{o_{k,d} + r_{k,d} = 1}_{\text{16 条比例行}}\ ,\ \ o, r \in [0,1]$$" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;strokeColor=none;fillColor=#f2f4f8;rounded=1;" vertex="1" parent="1"><mxGeometry x="120" y="66" width="1260" height="86" as="geometry" /></mxCell>
        <mxCell id="vt" value="变量布局 NV = 2GD + G + 2（G=8, D=2 → 36）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="620" height="150" as="geometry" /></mxCell>
        <mxCell id="v1" value="o[g,d]：本 rank 留存比例&lt;br&gt;（16 个）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="222" width="180" height="52" as="geometry" /></mxCell>
        <mxCell id="v2" value="r[g,d]：副本 rank 接收比例&lt;br&gt;（16 个）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="222" width="180" height="52" as="geometry" /></mxCell>
        <mxCell id="v3" value="slack s[g]（8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="524" y="222" width="100" height="52" as="geometry" /></mxCell>
        <mxCell id="v4" value="t：组内最大负载（目标）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="284" width="180" height="36" as="geometry" /></mxCell>
        <mxCell id="v5" value="Big-M 人工列（c=1000，保证 x=1 初始可行）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="332" y="284" width="292" height="36" as="geometry" /></mxCell>
        <mxCell id="ipm" value="求解：原始仿射尺度内点法（Dikin），固定 5 次迭代&lt;br&gt;每轮：y ← (A X² Aᵀ)⁻¹ A X² c（cusolverdx 块高斯消元，cuBLASDx 做矩阵积）&lt;br&gt;d ← x ⊙ (c − Aᵀy)；α ← 0.999 / max(d)；x ← x ⊙ (1 − α d)&lt;br&gt;归一化负载（max=1）保证数值；单 SM 单线程块内完成（共享内存）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="356" width="620" height="130" as="geometry" /></mxCell>
        <mxCell id="gn0" value="rank 0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="170" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn1" value="rank 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn2" value="rank 2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="360" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn3" value="rank 3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="550" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn4" value="rank 4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="550" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn5" value="rank 5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="550" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn6" value="rank 6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="gn7" value="rank 7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="90" height="46" as="geometry" /></mxCell>
        <mxCell id="tcap" value="冗余拓扑（README 示例 r2o，cube+对角线型；tests/utils.py 的 CUBE_8P2E_R2O 是另一组同构边）：16 条有向边 = 16 个 LP 比例变量。边 k → r2o[k,d] 表示「k 的第 d 个冗余槽复制边终点 rank 的第 d 个专家」，token 沿边按比例 o/r 分给两端" style="text;html=1;fontSize=13;align=center;strokeColor=none;fillColor=#fff2cc;rounded=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="664" width="640" height="62" as="geometry" /></mxCell>
        <mxCell id="e03" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn0" target="gn3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e30" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn3" target="gn2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn2" target="gn1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn1" target="gn0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e47" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn4" target="gn7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e76" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn7" target="gn6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e65" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn6" target="gn5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e54" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="gn5" target="gn4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e06" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn0" target="gn6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn1" target="gn7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e24" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn2" target="gn4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e35" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn3" target="gn5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e40" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn4" target="gn0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e51" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn5" target="gn1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e62" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn6" target="gn2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e73" style="endArrow=block;html=1;rounded=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1" source="gn7" target="gn3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tl" value="实线绿边 = 第 0 列 r2o（0→3→2→1→0 与 4→7→6→5→4 两个环）；虚线红边 = 第 1 列（跨环对角线）" style="text;html=1;fontSize=12;fontColor=#666666;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="820" y="630" width="640" height="26" as="geometry" /></mxCell>
        <mxCell id="lb" value="下界与验证：任何分流比都满足 max ≥ max(组均值, 最大固定负载)。本文 numpy 复刻 5 次迭代内点法（脚本 assets/lplb_lp_verify.py）：两种合成实例 imbalance 从 1.18/1.22 → 1.002，距下界 &lt; 0.004" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="620" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel></diagram>
</mxfile>
