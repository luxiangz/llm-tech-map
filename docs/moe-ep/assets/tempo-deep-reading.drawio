<mxfile host="app.diagrams.net" pages="2">
  <diagram id="tempo_pipeline" name="TEMPO 端到端数据流">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="TEMPO 端到端：求解在关键路径之外 —— decode 图内只有一个融合 kernel，逐 batch 表更新以 ≤200ms 陈旧度落地" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="16" width="1320" height="34" as="geometry" /></mxCell>
        <mxCell id="ph1" value="关键路径 · decode CUDA Graph 内（每步、每层，预算百 µs 级）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#b85450;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="640" height="26" as="geometry" /></mxCell>
        <mxCell id="ph2" value="离关键路径 · 后台（毫秒 ~ 200ms 级）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#82b366;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="500" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="Router top-k 概率&lt;br&gt;（不取 argmax，保概率）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="a2" value="融合 kernel（图内唯一新增）&lt;br&gt;概率分发：按 dispatch 表把 token&lt;br&gt;概率分到各副本 + 原子累积计数&lt;br&gt;（padding 行掩码，零清零内核）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="330" height="94" as="geometry" /></mxCell>
        <mxCell id="a3" value="dispatch all-to-all&lt;br&gt;+ grouped GEMM + combine&lt;br&gt;（负载相关项 = grouped GEMM）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="112" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="a4" value="层末同步&lt;br&gt;层时间 = max_g t_g × ~60 层&lt;br&gt;瓶颈 GPU 常态 1.5–2× 均值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="112" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="b1" value="侧流快照 + 跨 rank 聚合&lt;br&gt;refresher 线程读累积计数器&lt;br&gt;gloo 组窗口差分（不碰主图）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="512" width="310" height="90" as="geometry" /></mxCell>
        <mxCell id="b2" value="独立求解进程（非线程）&lt;br&gt;tempo_fast 四阶段 · numpy · 1.9 ms&lt;br&gt;①代价感知贪心播种（冷专家整只放）&lt;br&gt;②增广链再平衡（守平坦区）&lt;br&gt;③局部搜索+部分迁移（守线性区）&lt;br&gt;④1% 切换容差集成（token-LP 为可行点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="b3" value="表发布：pinned 暂存&lt;br&gt;→ 一次 H2D 拷贝&lt;br&gt;逻辑→物理 dispatch 表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="512" width="270" height="90" as="geometry" /></mxCell>
        <mxCell id="b4" value="黑盒校准（每 kernel/dtype/硬件 ~10 分钟）&lt;br&gt;(G, N) 网格微基准 → 交替拟合两段 max-affine&lt;br&gt;参数：地板 b≈14.8µs · 斜率 β · 拐点 n* · tile 阶梯 b₂≈b/3&lt;br&gt;错校准 = 错解：GEMM-only 参数在 B=128 倒亏 16%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1190" y="430" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eup" value="表供图内查表（≤200ms 陈旧度）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="b3" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="300" /><mxPoint x="495" y="300" /></Array></mxGeometry></mxCell>
        <mxCell id="ecnt" value="窗口计数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a2" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="413" y="440" /><mxPoint x="215" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="ecal" value="代价模型参数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;exitX=0;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="b4" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="490" /><mxPoint x="1180" y="546" /></Array></mxGeometry></mxCell>
        <mxCell id="n1" value="无锁安全设计：表任何中间状态都是合法分布 —— 空闲专家行不动、无效副本列恒零、kernel 用时逐行重归一化；单行撕裂最坏和为零 → 回退「在持有副本上均匀分布」（永不路由到无副本 GPU、不除零）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="750" height="80" as="geometry" /></mxCell>
        <mxCell id="n2" value="对照：UltraEP 求解在每层关键路径上（≤300µs，训练/prefill 付得起）；TEMPO 求解离路径（decode 步时百 µs 级，图内一 µs 都付不起）——同一招在不同预算下的两种摆法" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f2f4f8;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="840" y="680" width="690" height="80" as="geometry" /></mxCell>
        <mxCell id="lg" value="图例：蓝 = 关键路径数据流；红 = 图内唯一新增 kernel；绿 = 离路径的计数/求解/发布；黄 = 校准与安全机制&lt;br&gt;多节点：先解 makespan、再按「同节点优先」做源→副本配对（负载可证不变）；第三段 max-affine 吸收 all-to-all 通信（c₂+γN）" style="text;html=1;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1000" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tempo_phase" name="代价曲线与相图">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="一条曲线与一张图：两段 max-affine 代价模型（左）与最优策略相图（右）—— 2025 的三个代理都是这条曲线的投影" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="16" width="1300" height="34" as="geometry" /></mxCell>
        <mxCell id="lA" value="单卡 MoE 块时间模型：t = max(a + bG + b₂(T−G), c + βN)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="620" height="26" as="geometry" /></mxCell>
        <mxCell id="axX" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="560" /><mxPoint x="660" y="560" /></mxGeometry></mxCell>
        <mxCell id="axY" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="560" /><mxPoint x="110" y="120" /></mxGeometry></mxCell>
        <mxCell id="xl" value="每专家 token 数 n_e →" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="566" width="130" height="24" as="geometry" /></mxCell>
        <mxCell id="yl" value="耗时 t ↑" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="118" y="124" width="90" height="24" as="geometry" /></mxCell>
        <mxCell id="flat" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="330" /><mxPoint x="340" y="330" /></mxGeometry></mxCell>
        <mxCell id="rise" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="330" /><mxPoint x="640" y="170" /></mxGeometry></mxCell>
        <mxCell id="nstar" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="330" /><mxPoint x="340" y="560" /></mxGeometry></mxCell>
        <mxCell id="nsl" value="拐点 n* ≈ 156–168 (fp8) / 331 (bf16)" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="576" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="fl" value="平坦区：耗时 ∝ 激活副本数 G&lt;br&gt;地板 b = 14.8 µs = 权重流一遍&lt;br&gt;（roofline 的 1.13–1.24×，80–88% HBM）" style="text;html=1;fontSize=12.5;fontColor=#b85450;align=center;strokeColor=none;fillColor=#f8cecc;rounded=1;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="lin" value="线性区：耗时 ∝ token 数（128-tile 阶梯，b₂≈b/3 捕捉 L2 复用）&lt;br&gt;模型误差：两段 4–8%，+tile 后 2.0%" style="text;html=1;fontSize=12.5;fontColor=#17457e;align=center;strokeColor=none;fillColor=#dae8fc;rounded=1;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="proj" value="三个代理 = 曲线的投影：token 代理（EPLB/LPLB/UltraEP）只看蓝色段；激活代理（METRO）只看红色段；&lt;b&gt;TEMPO 对整条 max 计价&lt;/b&gt;&lt;br&gt;误价不对称：iso-activation 时间差最高 24×，iso-token 7.6× —— 混合是常态（decode 档 92–100% batch 两区并存）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f2f4f8;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="620" height="100" as="geometry" /></mxCell>
        <mxCell id="lB" value="相图：最优固定策略随 (B, 偏斜) 翻转；边界解析可预测" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="600" height="26" as="geometry" /></mxCell>
        <mxCell id="zoneM" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=60;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="560" height="240" as="geometry" /></mxCell>
        <mxCell id="zoneL" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;" vertex="1" parent="1"><mxGeometry x="830" y="390" width="560" height="200" as="geometry" /></mxCell>
        <mxCell id="band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="310" width="140" height="100" as="geometry" /></mxCell>
        <mxCell id="zM" value="M 区（小 B：深内存区）&lt;br&gt;激活均衡（METRO 式）最优&lt;br&gt;token 计数激活盲（错 5–17%）" style="text;html=1;fontSize=13;fontColor=#b85450;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="zL" value="L 区（大 B：计算区）&lt;br&gt;token-LP 最优（= LPLB/UltraEP 目标）&lt;br&gt;激活计数最高错 2.8×" style="text;html=1;fontSize=13;fontColor=#17457e;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="zT" value="转接带&lt;br&gt;TEMPO&lt;br&gt;+8.5~11.8%" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#5B8748;align=center;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1098" y="330" width="124" height="70" as="geometry" /></mxCell>
        <mxCell id="axB" value="→ B（每 GPU token 数）" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="axS" value="偏斜 s ↑" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="838" y="120" width="90" height="24" as="geometry" /></mxCell>
        <mxCell id="bs" value="翻转边界 B* = min(B*avg, B*hot) 解析预测&lt;br&gt;（热专家机制让边界左弯；a2a 口径 B*≈300；12/12 网格列命中实测翻转带）" style="text;html=1;fontSize=12.5;fontColor=#5B8748;align=center;strokeColor=none;fillColor=#d5e8d4;rounded=1;" vertex="1" parent="1"><mxGeometry x="830" y="620" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="why" value="读法：上线前用校准模型算一遍相图，就知道自己的工作点落在哪个区、值不值得上自适应调度 —— TEMPO 逐格贴住每格最优（最差 ≥ −0.3%），纯 regime 内与最优代理重合，增益集中在转接带；外推 EP32–64 混合区 6–6.5%（最大 15.5%），恰在理论预言处归零&lt;br&gt;主张原文：A phase diagram, not a universal win, is the claim —— 它预测结果，而不是承诺胜利" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1340" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
