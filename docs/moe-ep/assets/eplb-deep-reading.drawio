        <mxCell id="an1" value="Step 1 · balanced_packing(组负载 → 2 节点)：按组负载降序 G1(330)→N0、G3(325)→N1、G0(262)→当前较轻的 N1（满）、G2(116)→N0&lt;br&gt;⇒ N0 = {G1, G2} = 446，N1 = {G0, G3} = 587&lt;br&gt;组不跨节点 ⇒ 同组专家的 token 只需送到一个节点（配合 V3 组限定路由）" style="text;html=1;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=#fff2cc;rounded=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1180" y="66" width="290" height="220" as="geometry" /></mxCell>
        <mxCell id="nN0" value="Node 0（NVLink 域）Σ = 446" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="532" height="120" as="geometry" /></mxCell>
