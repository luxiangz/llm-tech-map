<mxfile host="app.diagrams.net" pages="3">
  <diagram id="eplb_pipeline" name="EPLB 端到端流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1120" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="EPLB 端到端流程：统计收集 → 布局计算 → 权重迁移 → 元数据切换（周期循环，不停服）" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="16" width="1160" height="34" as="geometry" /></mxCell>
        <mxCell id="phA" value="① 在线服务与统计收集" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="phB" value="② 周期触发与布局计算" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="phC" value="③ 权重迁移（不停服）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="phD" value="④ 元数据切换与继续服务" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="260" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="输入 tokens&lt;br&gt;[B, T, d]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="a2" value="Router&lt;br&gt;softmax(W_r · z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="258" y="118" width="162" height="56" as="geometry" /></mxCell>
        <mxCell id="a3" value="TopK&lt;br&gt;（V3: K = 8）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="468" y="118" width="140" height="56" as="geometry" /></mxCell>
        <mxCell id="a4" value="DeepEP dispatch&lt;br&gt;all-to-all（IB + NVLink）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="658" y="118" width="196" height="56" as="geometry" /></mxCell>
        <mxCell id="a5" value="EP ranks：grouped GEMM&lt;br&gt;热专家涌入 → 卡间负载差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="906" y="96" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="a5c1" value="E5 (热)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="922" y="136" width="62" height="24" as="geometry" /></mxCell>
        <mxCell id="a5c2" value="E10 (热)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="136" width="62" height="24" as="geometry" /></mxCell>
        <mxCell id="a5c3" value="E2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1058" y="136" width="52" height="24" as="geometry" /></mxCell>
        <mxCell id="a5c4" value="E7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1116" y="136" width="52" height="24" as="geometry" /></mxCell>
        <mxCell id="a5c5" value="E1 (热)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="922" y="164" width="62" height="24" as="geometry" /></mxCell>
        <mxCell id="a5c6" value="E11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="164" width="62" height="24" as="geometry" /></mxCell>
        <mxCell id="a6" value="DeepEP combine&lt;br&gt;all-to-all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1262" y="118" width="160" height="56" as="geometry" /></mxCell>
        <mxCell id="a7" value="统计收集（旁路）：ExpertDistributionRecorder / vLLM recorder&lt;br&gt;记录每逻辑专家 token 数，环形 buffer 窗口（SGLang 默认 1000 iter；vLLM window_size = 1000）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="252" width="520" height="74" as="geometry" /></mxCell>
        <mxCell id="ea12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea4r" value="计数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="a4" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b1" value="周期触发&lt;br&gt;V3 ≈ 每 10 min；SGLang 每 1000 iter&lt;br&gt;vLLM step_interval = 3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="248" height="74" as="geometry" /></mxCell>
        <mxCell id="b2" value="all-gather 各 rank 统计&lt;br&gt;weight [L, N_log]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="358" y="438" width="228" height="62" as="geometry" /></mxCell>
        <mxCell id="b3" value="EPLB 核心算法（eplb.py ≈ 170 行，纯放置计算，不碰模型权重）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="630" y="416" width="600" height="260" as="geometry" /></mxCell>
        <mxCell id="b3a" value="replicate_experts&lt;br&gt;&lt;b&gt;逐个复制 max(w_i / c_i) 的逻辑专家&lt;/b&gt;&lt;br&gt;直到 N_phy 个物理副本&lt;br&gt;（热专家负载被副本均摊）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="656" y="478" width="266" height="104" as="geometry" /></mxCell>
        <mxCell id="b3b" value="balanced_packing&lt;br&gt;&lt;b&gt;按权重降序，放入当前最轻且未满的包&lt;/b&gt;&lt;br&gt;两次使用：&lt;br&gt;① 专家组 → 节点（少跨节点流量）&lt;br&gt;② 物理专家 → GPU（卡间均衡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="944" y="478" width="266" height="104" as="geometry" /></mxCell>
        <mxCell id="b3c" value="层次化（组数可整除节点数）：Step1 组→节点 + Step2 节点内复制 + Step3 专家→卡&lt;br&gt;全局（否则）：跳过组约束，全局复制 + 全局打包" style="text;html=1;fontSize=12;fontColor=#7a5555;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="656" y="600" width="556" height="52" as="geometry" /></mxCell>
        <mxCell id="b4" value="新布局三件套&lt;br&gt;phy2log [L, N_phy]&lt;br&gt;log2phy · logcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1278" y="462" width="196" height="92" as="geometry" /></mxCell>
        <mxCell id="eb12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1" value="新旧布局 diff&lt;br&gt;vLLM preserve_intragpu_slots：&lt;br&gt;留在同卡的专家保原槽位，少搬权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="744" width="256" height="86" as="geometry" /></mxCell>
        <mxCell id="c2" value="批量 P2P isend / irecv&lt;br&gt;按逻辑专家去重发送&lt;br&gt;同节点源优先（省 IB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="366" y="744" width="256" height="86" as="geometry" /></mxCell>
        <mxCell id="c3" value="临时缓冲双阶段写&lt;br&gt;recv → temp buffer → 权重槽位&lt;br&gt;推理读旧权重不受阻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="672" y="744" width="256" height="86" as="geometry" /></mxCell>
        <mxCell id="c4" value="SGLang ExpertLocationUpdater 五 case 分级：&lt;br&gt;unchanged（跳过，零开销）/ same-gpu（卡内拷贝）/ free-rider（顺带接收）/ same-node / cross-node&lt;br&gt;分批提交防 NCCL 挂起；缺失专家 → DRAM backup 或磁盘 reload 恢复" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="728" width="470" height="118" as="geometry" /></mxCell>
        <mxCell id="ec12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec2c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4c1" value="新布局" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4" target="c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1376" y="695" /><mxPoint x="188" y="695" /></Array></mxGeometry></mxCell>
        <mxCell id="d1" value="physical_to_logical_map&lt;br&gt;原子替换（元数据切换）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="366" y="940" width="252" height="64" as="geometry" /></mxCell>
        <mxCell id="d2" value="dispatch 按新映射路由&lt;br&gt;冗余副本分流 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="672" y="940" width="252" height="64" as="geometry" /></mxCell>
        <mxCell id="d3" value="继续服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="998" y="940" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="ed12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="890" /><mxPoint x="492" y="890" /></Array></mxGeometry></mxCell>
        <mxCell id="ed23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eloop" value="进入下一轮统计窗口" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d3" target="a7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="972" /><mxPoint x="1490" y="289" /></Array></mxGeometry></mxCell>
        <mxCell id="lg" value="图例：蓝 = 数据/IO；绿 = 计算与通信；橙 = 路由决策；红 = EPLB 核心算法/热专家；灰 = 辅助；黄 = 机制说明&lt;br&gt;实线粗 = 主数据流；虚线 = 旁路统计 / 说明 / 循环回边" style="text;html=1;fontSize=12;fontColor=#666666;align=left;strokeColor=none;fillColor=#fafafa;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="620" height="56" as="geometry" /></mxCell>
