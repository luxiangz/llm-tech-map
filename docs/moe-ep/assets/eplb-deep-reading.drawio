  <diagram id="eplb_mapping" name="冗余专家与映射（V3 规模）">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="940" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mt1" value="冗余专家与物理/逻辑映射（DeepSeek-V3 规模）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="16" width="1000" height="32" as="geometry" /></mxCell>
        <mxCell id="mfacts" value="部署事实（V3 技术报告）：&lt;br&gt;· prefill：EP32（4 节点 × 8 卡），每卡 8 个专家 + 1 个冗余位（共 32 冗余）&lt;br&gt;· decode：EP320（40 节点），每卡 1 个专家&lt;br&gt;· 重排周期：基于在线统计 ≈ 每 10 分钟&lt;br&gt;· 组限定路由：每 token 最多跨 M = 4 个节点" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="mform" value="$$N_{\mathrm{phy}} = N_{\mathrm{log}} + R, \qquad \mathrm{eff}_i = \frac{w_i}{c_i}, \qquad L_{\mathrm{gpu}} = \sum_{i \in \mathrm{gpu}} \mathrm{eff}_i$$" style="text;html=1;fontSize=15;align=center;verticalAlign=middle;strokeColor=none;fillColor=#f2f4f8;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="mr1" value="Router 分数 s_i" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="180" height="52" as="geometry" /></mxCell>
        <mxCell id="mr2" value="TopK（K = 8）&lt;br&gt;选出逻辑专家 id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="190" height="52" as="geometry" /></mxCell>
        <mxCell id="mr3" value="log2phy 查表&lt;br&gt;逻辑 i → c_i 个物理副本槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="mr4" value="副本选择（rank 内取模 / 负载分流）&lt;br&gt;同一逻辑专家的 token 分散到各副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="230" height="66" as="geometry" /></mxCell>
        <mxCell id="mr5" value="dispatch 到对应物理 GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="190" height="66" as="geometry" /></mxCell>
        <mxCell id="me12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="mr1" target="mr2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="mr2" target="mr3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mr3" target="mr4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="mr4" target="mr5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mmap1" value="逻辑专家（N_log = 256）&lt;br&gt;e_a (c=1) · e_b (c=2) · e_c (c=1) · …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="mmap2" value="物理槽位（N_phy = 288 = 256 + 32）&lt;br&gt;e_a | e_b | e_b′ | e_c | …&lt;br&gt;均匀切到 32 张 GPU：每卡 9 个槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="mme" value="log2phy / phy2log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2430;" edge="1" parent="1" source="mmap1" target="mmap2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mnote" value="关键认识：EPLB 不改路由分数、不碰模型权重数值——只改变专家的放置位置与副本数量。&lt;br&gt;线上均衡依赖「统计 → 预测 → 周期重排」的开环控制；训练期的均衡（aux-loss-free bias）只保证长期期望均匀，&lt;br&gt;推理期的 batch 内 / 域偏移不均必须靠部署侧机制吸收。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="640" height="110" as="geometry" /></mxCell>
        <mxCell id="mlimit" value="局限与后续：&lt;br&gt;· 负载预测是尽力而为（LMSYS 部署用 in-distribution 数据模拟；分布漂移会削弱效果）&lt;br&gt;· token 均衡 ≠ 延迟均衡（arXiv:2606.00735：imbalance 可残留于延迟维度）&lt;br&gt;· 冗余专家吃显存（vLLM：DeepSeek-V3 每冗余专家每 rank ≈ 2.4 GB）&lt;br&gt;· 后续演进：DeepSeek LPLB（LP 求解，训练期）、ReLibra（路由重放）、动态冗余探索" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="480" width="620" height="150" as="geometry" /></mxCell>
        <mxCell id="mleg" value="图例：蓝 = 数据/映射；绿 = 计算/放置；橙 = 路由决策；黄 = 关键认识；灰 = 事实/局限" style="text;html=1;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="700" height="26" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
